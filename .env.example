# Variables de entorno del proyecto MAPS E-commerce.
# Copiar este archivo como .env y completar los valores reales por ambiente
# (local / staging / production). Nunca commitear el .env con valores reales.
# Ver docs/estructura.md > "Ambientes del proyecto" para más contexto.

# Base de datos (PostgreSQL, usada por Prisma)
DATABASE_URL=

# Autenticación (JWT)
JWT_SECRET=
JWT_REFRESH_SECRET=

# URLs de la aplicación
FRONTEND_URL=
API_URL=

# Integraciones externas
EMAIL_PROVIDER_API_KEY=
PAYMENT_PROVIDER_API_KEY=
STORAGE_PROVIDER_API_KEY=
